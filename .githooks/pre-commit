#!/bin/sh
# Rebuild every README from the templates in src/ and include them in the commit.
# Enable once per clone with:  git config core.hooksPath .githooks
set -e
cd "$(git rev-parse --show-toplevel)"

# "python" first: on Windows "python3" can be the Microsoft Store stub.
python=$(command -v python || command -v python3) || {
    echo "pre-commit: Python not found, cannot rebuild the READMEs" >&2
    exit 1
}

"$python" build.py
# Quoted so that git expands the patterns, whatever the languages are.
git add -- 'README*.md' '.github/README*.md'
